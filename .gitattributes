# ============================================================
#  换行符策略
#
#  为什么需要：Windows 批处理（.bat）对换行敏感 ——
#  用 LF 保存时，带 goto/标签的脚本可能执行异常，
#  而这类问题在 WSL 里编辑文件时非常容易无意中引入。
#  这里显式固定，避免来回改坏。
# ============================================================

# Windows 批处理必须用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本用 LF
*.sh text eol=lf

# 其余文本文件按仓库默认处理
*.md text
*.py text
*.ts text
*.tsx text
*.json text
*.yml text
*.yaml text
*.toml text

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# 跨仓契约按原始字节校验摘要，所有平台保持LF。
contracts/** text eol=lf

# 固定来源的P1评审样例按Git blob逐字节校验，保留LF。
backend/tests/fixtures/p1_mobile_review_cases.json text eol=lf

# 3100d32值候选的固定来源副本保持原始blob字节。
backend/tests/fixtures/p1_values_3100d32/** text eol=lf

# 0ff3913预约修正证据及同组词表保持原始blob字节。
backend/tests/fixtures/p1_values_0ff3913/** text eol=lf

# 6ab3a38原始JSON评审证据按原始blob固定LF。
backend/tests/fixtures/p1_json_6ab3a38/** text eol=lf
