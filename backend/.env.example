# ============================================================
#  TravelFlow AI 配置示例
#  复制本文件为 .env 后按需修改；未修改的项使用默认值。
#  .env 已被 .gitignore 忽略，不会被提交。
# ============================================================

# ---------------- 服务 ----------------
APP_HOST=127.0.0.1          # 仅本机可访问；若想让局域网其他设备访问，改为 0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false          # true 则输出 JSON 行格式日志（便于采集）
# 跨域来源白名单。默认只放行本机 3100（前端默认端口）。
# 若改了前端端口，请同步修改这里，或设 APP_CORS_STRICT=false 放宽。
# 用 start.sh / start.bat 启动时会**自动按实际端口注入**，无需手动改。
APP_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# 跨域严格模式（安全相关）：
#   true （默认）= 只放行上面白名单里的来源；
#   false        = 额外放行任意本机端口（localhost/127.0.0.1 的任意端口）。
#
# 提示：本服务的真实安全边界是 APP_HOST=127.0.0.1（只允许本机访问）。
# 该开关属于纵深防御，限制的是「本机其它端口的页面能否读取本 API」。
APP_CORS_STRICT=true

# ---------------- 大模型 ----------------
# 云端可选：deepseek / openai / moonshot / zhipu / dashscope / siliconflow
# 本地可选：ollama / vllm / lmstudio / custom  （本地部署无需 API Key）
LLM_PROVIDER=deepseek
# 模型名可能随服务商调整；界面「设置」可一键获取当前可用模型
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_BASE_URL=               # 留空则使用服务商默认地址
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# 使用本地 Ollama 时，把上面三项换成：
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1

# ---------------- 信息检索 ----------------
# 可选：tavily / bocha / qianfan / searxng / ddg
# ddg（DuckDuckGo）无需任何 Key，适合零配置试用
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=20
SEARXNG_BASE_URL=           # 仅在 SEARCH_PROVIDER=searxng 时需要

# ---------------- 生成偏好 ----------------
# 可选：L1_minimal / L2_standard / L3_detailed / L4_butler
DEFAULT_DETAIL_LEVEL=L2_standard

# ---------------- 数据 ----------------
SESSION_DB_PATH=./data/travelflow.db
SESSION_TTL_HOURS=168
