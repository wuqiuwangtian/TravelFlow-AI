# ============================================================
#  Docker Compose 部署用的环境变量（复制为根目录 .env）
#
#  说明：全部可以留空 —— 服务仍能启动，之后在界面「设置」里填写即可。
# ============================================================

# ---------------- 大模型 ----------------
# 可选：deepseek / openai / moonshot / zhipu / dashscope / siliconflow
#       ollama / vllm / lmstudio / custom（本地部署无需 Key）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=

# ---------------- 检索 ----------------
# 可选：tavily / bocha / qianfan / searxng / ddg
# ddg 无需任何 Key，适合零配置试用
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# 使用内置 SearXNG 时填 http://searxng:8080
SEARXNG_BASE_URL=http://searxng:8080

# ---------------- 其它 ----------------
APP_LOG_LEVEL=INFO
DEFAULT_DETAIL_LEVEL=L2_standard
# 前端浏览器访问后端的地址（默认本机）
NEXT_PUBLIC_API_BASE=http://localhost:8000
# 仅使用 SearXNG profile 时需要修改
SEARXNG_SECRET=please-change-this-secret
