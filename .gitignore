# ============================================================
#  哪些文件不该进 Git
#
#  为什么留着这个文件：`.env` 里存着你的 **API Key**。
#  没有下面那条规则的话，一句 `git add .` 就会把它提交上去 ——
#  推到公开仓库就等于把密钥公开了。
#
#  其余都是运行时会自动生成、不需要版本管理的文件。
# ============================================================

# 你的配置（含 API Key）—— 千万不要提交
.env
.env.local

# 会话与路书数据（你的旅行记录都在这里）
data/
*.db
*.db-journal
*.db-wal

# 依赖与构建产物（体积大，可随时重新生成）
.venv*/
node_modules/
.next/
frontend/next-env.d.ts
*.tsbuildinfo

# 测试覆盖率报告
.coverage
htmlcov/
test-results/
playwright-report/

# Python 缓存
__pycache__/
*.py[cod]

# 本机开发笔记（目录不存在时此条无影响）
.dev-notes/
