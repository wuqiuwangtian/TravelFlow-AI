        "effect": "changed"
      }
    },
    "interrupted_before_commit": {
      "desktop": {
        "exit_code": 86,
        "stdout_empty": true
      },
      "mobile_host_and_android": {
        "interrupted_before_commit": true
      }
    },
    "interrupted_after_commit": {
      "desktop": {
        "exit_code": 86,
        "stdout_empty": true
